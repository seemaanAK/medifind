# MediFind Environment Variables Configuration
# Copy this file to .env and provide your credentials as needed.
# NEVER commit .env with real secrets to source control.

# ==============================================================================
# FRONTEND CONFIGURATION (Exposed to browser via Vite)
# ==============================================================================
VITE_SUPABASE_URL=https://ixndnyaeahvjracdotwo.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_I4wsGQTgTjnUbuXVTiM9fA_kxm3ZEzy
VITE_API_BASE_URL=http://localhost:3001

# ==============================================================================
# BACKEND SERVER CONFIGURATION (Server-only, private)
# ==============================================================================
NODE_ENV=development
PORT=3001

# Supabase Server-side Credentials
SUPABASE_URL=https://ixndnyaeahvjracdotwo.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_I4wsGQTgTjnUbuXVTiM9fA_kxm3ZEzy
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional Google Gemini AI Configuration (Used strictly on server for non-diagnostic summarization)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# Pharmacy Provider Configuration (Optional external integration)
PHARMACY_PROVIDER=internal
PHARMACY_PROVIDER_API_KEY=
PHARMACY_PROVIDER_BASE_URL=

# Medicine Data Provider Configuration (Optional external integration)
MEDICINE_DATA_PROVIDER=cdsco_ip
MEDICINE_DATA_PROVIDER_API_KEY=
MEDICINE_DATA_PROVIDER_BASE_URL=

# Security & CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# Emergency Verification Freshness Policy (in days)
EMERGENCY_CONTACT_VERIFICATION_MAX_AGE_DAYS=365
